{
  "manifest_version": 3,
  "name": "in-stitution",
  "version": "0.11.2",
  "description": "Institutional sign-in for research sites, with configurable university profiles and shared provider adapters.",
  "minimum_chrome_version": "135",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "userScripts"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sign in with your institution",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "packs.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.webofscience.com/*",
        "https://*.webofknowledge.com/*",
        "https://*.webofscience.clarivate.cn/*",
        "https://access.clarivate.com/*",
        "https://login.clarivate.com/*",
        "https://*.sciencedirect.com/*",
        "https://*.scopus.com/*",
        "https://auth.elsevier.com/*",
        "https://link.springer.com/*",
        "https://link.springernature.com/*",
        "https://www.nature.com/*",
        "https://idp.springer.com/*",
        "https://fsso.springer.com/*",
        "https://sp.nature.com/*",
        "https://secure.nature.com/*",
        "https://idp.nature.com/*",
        "https://auth.springernature.com/*",
        "https://onlinelibrary.wiley.com/*",
        "https://login.wiley.com/*",
        "https://ieeexplore.ieee.org/*",
        "https://pubs.acs.org/*",
        "https://pubs.rsc.org/*",
        "https://www.rsc.org/*",
        "https://shib.rsc.org/*",
        "https://*.cnki.net/*",
        "https://*.tandfonline.com/*",
        "https://*.jstor.org/*",
        "https://ds.carsi.edu.cn/*",
        "https://service.seamlessaccess.org/*",
        "https://wayf.springernature.com/*",
        "https://sso.rsc.org/*",
        "https://id.elsevier.com/*",
        "https://shib.sso.rsc.org/*"
      ],
      "js": [
        "institutions/registry.js",
        "institutions/auth.js",
        "institutions/manual.js",
        "institutions/standard-cas.js",
        "institutions/executable.js",
        "institutions/catalog.js",
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "sandbox": {
    "pages": [
      "pack-settings-frame.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'",
    "sandbox": "sandbox allow-scripts allow-forms; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; default-src 'none'; connect-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
